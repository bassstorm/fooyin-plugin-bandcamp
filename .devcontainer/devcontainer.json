{
    "name": "fooyin-plugin-bandcamp",
    "image": "mcr.microsoft.com/devcontainers/cpp:2-bookworm",

    "remoteUser": "vscode",
    "updateRemoteUserUID": true,

    "features": {
        "./features/fooyin": {
            "version": "v0.14.1"
        }
    },

    "mounts": [
        "source=${localEnv:SSH_AUTH_SOCK},target=/ssh-agent,type=bind"
    ],
    "remoteEnv": {
        "SSH_AUTH_SOCK": "/ssh-agent"
    }
}
