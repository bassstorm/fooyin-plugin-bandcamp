{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Development build",
      "binaryDir": "${sourceDir}/build"
    },
    {
      "name": "tests",
      "displayName": "Deterministic and live tests",
      "binaryDir": "${sourceDir}/build-tests",
      "cacheVariables": {
        "BANDCAMP_PLUGIN_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "tests-sanitize",
      "displayName": "Deterministic and live tests with AddressSanitizer and UndefinedBehaviorSanitizer",
      "binaryDir": "${sourceDir}/build-sanitize",
      "cacheVariables": {
        "BANDCAMP_PLUGIN_SANITIZE": "ON"
      },
      "inherits": [ "tests" ]
    },
    {
      "name": "release",
      "displayName": "Release build",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "snapshot",
      "displayName": "Snapshot build",
      "binaryDir": "${sourceDir}/build-snapshot",
      "cacheVariables": {
        "BANDCAMP_PLUGIN_VERSION_SUFFIX": "-snapshot"
      },
      "inherits": [ "release" ]
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "tests",
      "configurePreset": "tests",
      "targets": [ "bandcamp_deterministic_tests", "bandcamp_live_tests", "bandcamp_plugin_input_tests" ]
    },
    {
      "name": "tests-sanitize",
      "configurePreset": "tests-sanitize",
      "targets": [ "bandcamp_deterministic_tests", "bandcamp_live_tests", "bandcamp_plugin_input_tests" ]
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "release-bundle",
      "configurePreset": "release",
      "targets": [ "bandcamp_bundle" ]
    },
    {
      "name": "snapshot-bundle",
      "configurePreset": "snapshot",
      "targets": [ "bandcamp_bundle" ]
    }
  ],
  "testPresets": [
    {
      "name": "tests",
      "configurePreset": "tests",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "tests-sanitize",
      "configurePreset": "tests-sanitize",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "tests-ci",
      "configurePreset": "tests-sanitize",
      "filter": {
        "exclude": {
          "label": "^live$"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "tests-live",
      "configurePreset": "tests",
      "filter": {
        "include": {
          "label": "^live$"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
